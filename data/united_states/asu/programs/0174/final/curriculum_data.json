    {
      "category": "programme",
      "subcategory": "curriculum",
      "field": "folk_religions",
      "value": "Chinese folk religion includes the syncretism of Confucianism, Taoism, and Buddhism, Wuism, as well as many new religious movements such as Chen Tao, Falun Gong, and Yiguandao. Other folk and new religions of East Asia and Southeast Asia include Korean shamanism, Chondogyo, and Jeung San Do in Korea; indigenous Philippine folk religions in the Philippines; Shinto, Shugendo, Ryukyuan religion, and Japanese new religions in Japan; Satsana Phi in Laos; Vietnamese folk religion, and Cao Đài, Hòa Hảo in Vietnam.",
      "confidence": 1.0,
      "source_url": "",
      "source_type": "",
      "programme_association": "",
      "metadata": {
        "chunk_id": "page_0026",
        "chunk_title": "Folk religions + Indian religions",
        "chunk_order": 25,
        "source_type": "page"
      }
    },
    {
