    {
      "category": "programme",
      "subcategory": "curriculum",
      "field": "description",
      "value": "A one-year postgraduate bachelor honours degree can be achieved as a consecutive stand-alone course following a bachelor's degree in the same field, or as an additional year as part of a bachelor's degree program. The honours course is normally only open to those who do well in their bachelor's degree program and involves study at a more advanced level than that bachelor's degree.",
      "confidence": 1.0,
      "source_url": "",
      "source_type": "",
      "programme_association": "",
      "metadata": {
        "chunk_id": "page_0006",
        "chunk_title": "Programme Information - Part 6",
        "chunk_order": 5,
        "source_type": "page"
      }
    },
    {
      "category": "programme",
      "subcategory": "curriculum",
      "field": "alignment",
      "value": "Both the bachelor and bachelor honours degrees are aligned with level 6 of the EQF, the same as British and Irish bachelor's degrees with and without honours, and other Bologna Process first cycle qualifications.",
