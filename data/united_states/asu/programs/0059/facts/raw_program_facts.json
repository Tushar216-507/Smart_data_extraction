    {
      "category": "curriculum",
      "field": "description",
      "value": "A one-year postgraduate bachelor honours degree can be achieved as a consecutive stand-alone course following a bachelor's degree in the same field, or as an additional year as part of a bachelor's degree program. The honours course is normally only open to those who do well in their bachelor's degree program and involves study at a more advanced level than that bachelor's degree.",
      "confidence": 1.0,
      "source": {
        "source_type": "page",
        "url": ""
      },
