      "category": "admission",
      "field": "admission_requirements",
      "value": "Applicants must have earned a bachelor's or master's degree, in any field, from a regionally accredited institution. Transcripts must show evidence of having completed the equivalent of 15 credit hours of undergraduate work in the study of religions, including advanced courses in both Western and Asian or other non-Western religions.",
      "confidence": 1.0,
      "source": {
        "source_type": "program",
        "url": ""
      },
