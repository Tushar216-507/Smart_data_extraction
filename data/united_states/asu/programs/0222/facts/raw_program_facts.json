      }
    },
    {
      "category": "admission",
      "field": "gpa_requirements",
      "value": "Applicants must have a minimum cumulative GPA of 3.30 (scale is 4.00 = 'A') in the last 60 hours of their first bachelor's degree program or applicants must have a minimum cumulative GPA of 3.00 (scale is 4.00 = 'A') in an applicable master's degree program. The most competitive applicants have a GPA of 3.50 or higher.",
      "confidence": 1.0,
