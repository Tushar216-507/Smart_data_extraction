    },
    {
      "category": "other",
      "field": "theory_description",
      "value": "One modern academic theory of religion, social constructionism, says that religion is a modern concept that suggests all spiritual practice and worship follows a model similar to the Abrahamic religions as an orientation system that helps to interpret reality and define human beings.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0016",
        "chunk_title": "Social constructionism",
        "chunk_order": 15,
        "source_type": "page"
      }
    },
    {
      "category": "other",
      "field": "proponents",
      "value": "Daniel Dubuisson, Timothy Fitzgerald, Talal Asad, Jason Ānanda Josephson",
