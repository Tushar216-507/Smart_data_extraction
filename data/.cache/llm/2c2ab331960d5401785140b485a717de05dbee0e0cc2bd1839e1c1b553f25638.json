      }
    },
    {
      "category": "other",
      "field": "theory_argument",
      "value": "The social constructionists argue that religion is a modern concept that developed from Christianity and was then applied inappropriately to non-Western cultures.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
