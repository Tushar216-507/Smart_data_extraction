    },
    {
      "category": "other",
      "field": "description",
      "value": "Cognitive science of religion is the study of religious thought and behavior from the perspective of the cognitive and evolutionary sciences.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0017",
        "chunk_title": "Cognitive science",
        "chunk_order": 16,
        "source_type": "page"
      }
    },
    {
      "category": "other",
      "field": "methods_and_disciplines",
      "value": "The field employs methods and theories from a very broad range of disciplines, including cognitive psychology, evolutionary psychology, cognitive anthropology, artificial intelligence, cognitive neuroscience, neurobiology, zoology, and ethology.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0017",
        "chunk_title": "Cognitive science",
        "chunk_order": 16,
        "source_type": "page"
      }
    },
    {
      "category": "other",
      "field": "explanation_focus",
      "value": "Scholars in this field seek to explain how human minds acquire, generate, and transmit religious thoughts, practices, and schemas by means of ordinary cognitive capacities.",
