      }
    },
    {
      "category": "curriculum",
      "field": "subdisciplines",
      "value": [
        "Statics: the study of non-moving bodies under known loads.",
        "Dynamics: the study of how forces affect moving bodies, including kinematics and kinetics.",
        "Mechanics of materials: the study of how different materials deform under various types of stress.",
        "Fluid mechanics: the study of how fluids react to forces.",
        "Kinematics: the study of the motion of bodies and systems, ignoring the forces that cause the motion.",
        "Continuum mechanics: a method of applying mechanics that assumes that objects are continuous."
      ],
      "confidence": 1.0,
      "source": {
