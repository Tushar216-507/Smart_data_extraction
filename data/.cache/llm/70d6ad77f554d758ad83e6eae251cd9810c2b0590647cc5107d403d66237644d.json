    },
    {
      "category": "curriculum",
      "field": "module_function",
      "value": "Analysts, managers, business owners, and accountants use information from cost accounting to determine product costs.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0007",
        "chunk_title": "Cost Accounting",
        "chunk_order": 6,
        "source_type": "page"
      }
    },
    {
      "category": "curriculum",
      "field": "module_difference",
      "value": "In cost accounting, money is considered an economic factor in production, whereas in financial accounting, money is viewed as a measure of a company's economic performance.",
