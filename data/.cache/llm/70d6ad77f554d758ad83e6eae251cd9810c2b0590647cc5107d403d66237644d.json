    {
      "category": "curriculum",
      "field": "module_description",
      "value": "Cost accounting helps businesses make decisions about costing by considering all of the costs related to producing a product.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0007",
        "chunk_title": "Cost Accounting",
