    },
    {
      "category": "curriculum",
      "field": "module_description",
      "value": "Managerial accounting uses much of the same data as financial accounting, but it organizes and utilizes information in different ways. In managerial accounting, an accountant generates monthly or quarterly reports that a business's management team can use to make decisions about how the business operates.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0006",
        "chunk_title": "Managerial Accounting",
        "chunk_order": 5,
        "source_type": "page"
      }
    },
    {
      "category": "curriculum",
      "field": "module_scope",
      "value": "Managerial accounting also encompasses many other facets of accounting, including budgeting, forecasting, and various financial analysis tools. Any information that may be useful to management falls under this umbrella.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0006",
        "chunk_title": "Managerial Accounting",
        "chunk_order": 5,
        "source_type": "page"
      }
    },
