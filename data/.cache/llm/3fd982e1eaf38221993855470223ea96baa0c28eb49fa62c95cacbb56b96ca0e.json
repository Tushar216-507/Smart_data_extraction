    {
      "category": "overview",
      "field": "description",
      "value": "Design and Manufacture Engineering covers a range of topics which are directly relevant to solving big real-world problems. As we know, manufacturing is the backbone of modern society and creates the wealth of a nation.",
      "confidence": 1.0,
      "source": {
        "source_type": "program",
        "chunk_id": "program_0002",
        "title": "What is a Bachelor of Engineering in Design and Manufacture?",
        "url": null
      },
      "metadata": {}
    },
    {
      "category": "overview",
      "field": "graduate_vision",
      "value": "The vision for graduates from the BE in Design and Manufacture programme, is for them to design useful working products, seeing them developed from possibility and concept, through the practicalities of manufacture, to real use, and eventual recycling after their life’s end.",
      "confidence": 1.0,
      "source": {
        "source_type": "program",
        "chunk_id": "program_0002",
        "title": "What is a Bachelor of Engineering in Design and Manufacture?",
        "url": null
      },
      "metadata": {}
    },
    {
      "category": "overview",
      "field": "accreditation",
      "value": "The Engineers Ireland accredited BE in Design and Manufacture includes a cooperative education placement and adheres to traditional educational guidelines of preparation for the profession of engineering.",
      "confidence": 1.0,
      "source": {
        "source_type": "program",
        "chunk_id": "program_0002",
        "title": "What is a Bachelor of Engineering in Design and Manufacture?",
        "url": null
      },
      "metadata": {}
    },
    {
      "category": "curriculum",
      "field": "subjects_covered",
      "value": "You will cover a range of subjects including fundamentals of design and production processes, computer-aided design, automation, materials, quality, capacity planning and simulation, costs and sustainability.",
      "confidence": 1.0,
      "source": {
        "source_type": "program",
        "chunk_id": "program_0002",
        "title": "What is a Bachelor of Engineering in Design and Manufacture?",
        "url": null
      },
      "metadata": {}
    },
    {
      "category": "curriculum",
      "field": "learning_principles",
      "value": "The programme follows CDIO principles (Conceive-Design-implement- Operate) including active learning and problem-based learning; these are important elements of the programme in each year.",
      "confidence": 1.0,
      "source": {
        "source_type": "program",
