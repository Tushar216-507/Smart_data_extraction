    {
      "category": "other",
      "field": "definition",
      "value": "In Ancient Greece, the Greek term threskeia was loosely translated into Latin as religiō in late antiquity.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0004",
        "chunk_title": "Threskeia",
        "chunk_order": 3,
        "source_type": "page"
      }
    },
    {
      "category": "other",
      "field": "usage",
      "value": "Threskeia was sparsely used in classical Greece but became more frequently used in the writings of Josephus in the 1st century CE.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0004",
        "chunk_title": "Threskeia",
        "chunk_order": 3,
        "source_type": "page"
      }
    },
    {
      "category": "other",
      "field": "meanings",
      "value": "Threskeia could mean multiple things from respectful fear to excessive or harmfully distracting practices of others, to cultic practices.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0004",
        "chunk_title": "Threskeia",
        "chunk_order": 3,
        "source_type": "page"
      }
    },
    {
      "category": "other",
      "field": "contrast",
      "value": "Threskeia was often contrasted with the Greek word deisidaimonia, which meant too much fear.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0004",
