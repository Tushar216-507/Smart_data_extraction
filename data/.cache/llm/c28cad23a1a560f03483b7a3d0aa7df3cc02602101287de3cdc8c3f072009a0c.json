        "source_type": "page"
      }
    },
    {
      "category": "admission",
      "field": "unofficial_transcripts",
      "value": "ASU accepts unofficial transcripts as part of the application. This is the only way we will accept unofficial transcripts. Emailed transcripts are not acceptable.",
