    {
      "category": "other",
      "field": "social_media_definition_merriam_webster",
      "value": "Forms of electronic communication (such as websites for social networking and microblogging) through which users create online communities to share information, ideas, personal messages, and other content (such as videos).",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0004",
        "chunk_title": "Definition",
        "chunk_order": 3,
        "source_type": "page"
      }
    },
    {
      "category": "other",
      "field": "social_media_definition_nist",
      "value": "Forms of electronic communications, including websites and applications, that enable users to create and share content or to participate in social networking.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0004",
        "chunk_title": "Definition",
        "chunk_order": 3,
        "source_type": "page"
      }
    },
