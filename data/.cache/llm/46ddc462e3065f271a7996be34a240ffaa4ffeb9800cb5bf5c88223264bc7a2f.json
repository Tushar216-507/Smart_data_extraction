      }
    },
    {
      "category": "overview",
      "field": "origin",
      "value": "Modern civil law systems essentially derive from legal codes issued by Byzantine Emperor Justinian I in the 6th century.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "page_0007",
        "chunk_title": "Civil law",
