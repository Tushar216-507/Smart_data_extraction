    {
      "category": "overview",
      "field": "description",
      "value": "Industrialisation led to the creation of the factory. The factory system contributed to the growth of urban areas as workers migrated into the cities in search of work in the factories.",
      "confidence": 1.0,
      "source": {
        "source_type": "page",
        "source_id": "page_0039",
        "title": "Factories and urbanisation",
        "url": null
      },
      "metadata": {
        "chunk_id": "page_0039",
        "chunk_title": "Factories and urbanisation",
        "chunk_order": 38
      }
    },
    {
      "category": "overview",
      "field": "historical_example",
      "value": "Manchester experienced a six-times increase in population between 1771 and 1831. Bradford grew by 50% every ten years between 1811 and 1851, and by 1851 only 50% of its population were born there.",
      "confidence": 1.0,
      "source": {
        "source_type": "page",
        "source_id": "page_0039",
        "title": "Factories and urbanisation",
        "url": null
      },
      "metadata": {
        "chunk_id": "page_0039",
        "chunk_title": "Factories and urbanisation",
        "chunk_order": 38
      }
    },
    {
      "category": "overview",
      "field": "production_methods",
      "value": "For much of the 19th century, production was done in small mills which were typically water-powered and built to serve local needs.",
      "confidence": 1.0,
      "source": {
        "source_type": "page",
        "source_id": "page_0039",
        "title": "Factories and urbanisation",
        "url": null
      },
      "metadata": {
        "chunk_id": "page_0039",
        "chunk_title": "Factories and urbanisation",
        "chunk_order": 38
      }
    },
    {
      "category": "overview",
      "field": "factory_development",
      "value": "Later, each factory would have its own steam engine and a chimney to give an efficient draft through its boiler.",
      "confidence": 1.0,
      "source": {
        "source_type": "page",
        "source_id": "page_0039",
        "title": "Factories and urbanisation",
        "url": null
      },
      "metadata": {
        "chunk_id": "page_0039",
        "chunk_title": "Factories and urbanisation",
        "chunk_order": 38
      }
    },
    {
      "category": "overview",
      "field": "early_reformer",
      "value": "Some industrialists tried to improve factory and living conditions for their workers. One early reformer was Robert Owen, known for his pioneering efforts in improving conditions for workers at the New Lanark mills.",
      "confidence": 1.0,
      "source": {
        "source_type": "page",
        "source_id": "page_0039",
        "title": "Factories and urbanisation",
        "url": null
      },
      "metadata": {
        "chunk_id": "page_0039",
        "chunk_title": "Factories and urbanisation",
        "chunk_order": 38
      }
    },
    {
      "category": "overview",
      "field": "historical_fact",
      "value": "By 1746 an integrated brass mill was working at Warmley near Bristol. Raw material was smelted into brass and turned into pans, pins, wire, and other goods. Housing was provided for workers on site.",
      "confidence": 1.0,
      "source": {
        "source_type": "page",
        "source_id": "page_0039",
        "title": "Factories and urbanisation",
        "url": null
      },
      "metadata": {
        "chunk_id": "page_0039",
        "chunk_title": "Factories and urbanisation",
        "chunk_order": 38
      }
    },
    {
      "category": "overview",
      "field": "notable_industrialists",
      "value": "Josiah Wedgwood and Matthew Boulton were other prominent early industrialists who employed the factory system.",
