    {
      "category": "overview",
      "field": "description",
      "value": "The Master of Science in Urban Design and Climate Resilience is a two-year full-time Level 9 professional degree programme. It is an intensive and dynamic programme and prepares you for the range of professional activities in Urban Design, Sustainability and Climate Resilience.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "curriculum",
      "field": "methodology",
      "value": "The Design Studio is at the core of the teaching methodology.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "curriculum",
      "field": "environment",
      "value": "The programme is situated in The School of Architecture and Product Design and offers an interdisciplinary studio environment, guided by experts from fields such as urbanism, architecture, landscape architecture, ecology, history, science, and philosophy.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "curriculum",
      "field": "approach",
      "value": "The learning environment as a studio-based programme is experiential, challenge driven, student centred and collaborative.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "curriculum",
      "field": "content",
      "value": "The programme is cutting edge in its content and therefore research-led, using current thinking and engaging students to develop contemporary research in the field of urban design and climate resilience.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "research",
      "field": "focus",
      "value": "For the past 15 years, the School of Architecture and Product Design has led the Intelligence Unit (IU), a research initiative focused on contemporary urban and regional issues, particularly in Limerick.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "research",
      "field": "initiative",
      "value": "This new programme will become part of a Global IU, expanding its scope to explore urban challenges across diverse geographic, environmental, and political contexts.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "curriculum",
      "field": "projects",
      "value": "Wherever possible, we will collaborate with local stakeholders on real-world projects, ensuring that our work remains relevant and impactful.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "curriculum",
      "field": "collaboration",
      "value": "The School of Architecture and Product Design in Limerick has spent the past three years collaborating with the School of Architecture in Kharkiv, Ukraine, on the country’s rebuilding programme.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "curriculum",
      "field": "partnership",
      "value": "This partnership has engaged NGOs, local public sector architects, mayoral departments, and international academics and practitioners.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "curriculum",
      "field": "new_programmes",
      "value": "The collaboration has led to the launch of two new urban design programmes, one in Ireland and one in Ukraine running in parallel.",
      "confidence": 1.0,
      "source": null,
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "curriculum",
      "field": "participation",
      "value": "In their first semester, and building on three years of joint work on Ukrainian cities, students from the School of Architecture in Limerick will contribute to Ukraine’s post-war rebuilding efforts alongside their counterparts in Kharkiv as part of the ‘Global IU.",
