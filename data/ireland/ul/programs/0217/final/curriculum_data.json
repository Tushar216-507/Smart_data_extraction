    {
      "category": "programme",
      "subcategory": "curriculum",
      "field": "module_description",
      "value": "Microeconomics examines how entities, forming a market structure, interact within a market to create a market system. These entities include private and public players with various classifications, typically operating under scarcity of tradable units and regulation. The item traded may be a tangible product, such as apples, or a service, such as repair services, legal counsel, or entertainment.",
      "confidence": 1.0,
      "source_url": "",
      "source_type": "",
      "programme_association": "",
      "metadata": {
        "chunk_id": "page_0016",
