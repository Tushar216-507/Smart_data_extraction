    {
      "category": "curriculum",
      "field": "curriculum_objective_1",
      "value": "To provide an education at a suitable level in the appropriate branches of mathematics, both by exploring and developing standard methods and techniques with due use of mathematical, symbolic and statistical computing packages and by having due regard to the fundamental ideas of proof, rigour and generalisation.",
      "confidence": 1.0,
      "source": {
        "source_type": "program",
        "url": ""
      },
      "metadata": {
        "chunk_id": "program_0001",
        "chunk_title": "Programme Information",
        "chunk_order": 0,
        "source_type": "program"
      }
    },
    {
      "category": "curriculum",
      "field": "curriculum_objective_2",
      "value": "To introduce you to state of the art theory and methodologies in the world of pricing of financial products and modelling of markets and the practical implementations of these models.",
